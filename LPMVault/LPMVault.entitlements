<?xml version="1.0" encoding="UTF-8"?>
<!-- NOTE: This entitlements file must be referenced in the Xcode project build settings.
     Set CODE_SIGN_ENTITLEMENTS = LPMVault/LPMVault.entitlements in the target's build settings,
     or drag this file into the Xcode project and assign it under Signing & Capabilities. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.lpm.vault</string>
	</array>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
