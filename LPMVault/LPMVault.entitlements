<?xml version="1.0" encoding="UTF-8"?>
<!-- LPM Vault intentionally runs outside the App Sandbox. It interoperates with the
     Rust CLI through the user's login Keychain and ~/.lpm session metadata. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.application-identifier</key>
	<string>823S8YKMRW.dev.lpm.vault</string>
	<key>com.apple.developer.team-identifier</key>
	<string>823S8YKMRW</string>
	<key>keychain-access-groups</key>
	<array>
		<string>823S8YKMRW.dev.lpm.vault.shared</string>
	</array>
</dict>
</plist>
